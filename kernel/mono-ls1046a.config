# Mono Gateway DK (NXP LS1046A) + ASK, merged on top of VyOS's arm64
# vyos_defconfig and config/*.config fragments. Values follow the OpenWrt
# production kernel (layerscape/armv8_64b, 6.12.112) for everything the board
# and the ASK fast path need; everything else stays as VyOS has it.

# --- NXP SDK DPAA1 / FMan / QBMan (ASK's data plane) -------------------------
# The SDK drivers replace mainline DPAA: FSL_SDK_FMAN requires !FSL_FMAN, and
# the CDX module depends on FSL_SDK_FMAN, so mainline must be off explicitly.
# CONFIG_FSL_FMAN is not set
# CONFIG_FSL_DPAA is not set
CONFIG_STAGING=y
CONFIG_FSL_SDK_FMAN=y
CONFIG_FSL_SDK_DPAA_ETH=y
CONFIG_FSL_DPAA_OFFLINE_PORTS=y
CONFIG_FSL_DPAA_ADVANCED_DRIVERS=y
CONFIG_FSL_DPAA_ETH_JUMBO_FRAME=y
CONFIG_FSL_DPAA_TS=y
CONFIG_FSL_DPAA_1588=y
CONFIG_FSL_DPAA_ETH_MAX_BUF_COUNT=640
CONFIG_FSL_DPAA_ETH_REFILL_THRESHOLD=80
CONFIG_FSL_DPAA_CS_THRESHOLD_1G=0x06000000
CONFIG_FSL_DPAA_CS_THRESHOLD_10G=0x10000000
CONFIG_FSL_DPAA_ETH_DEBUGFS=y
CONFIG_FSL_SDK_DPA=y
CONFIG_FSL_DPA_CAN_WAIT=y
CONFIG_FSL_DPA_CAN_WAIT_SYNC=y
CONFIG_FSL_DPA_PIRQ_FAST=y
CONFIG_FSL_DPA_PIRQ_SLOW=y
CONFIG_FSL_DPA_PORTAL_SHARE=y
CONFIG_FSL_SDK_BMAN=y
CONFIG_FSL_ASK_QMAN_PORTAL_NAPI=y
CONFIG_FSL_BMAN_CONFIG=y
CONFIG_FSL_BMAN_DEBUGFS=y
CONFIG_FSL_SDK_QMAN=y
CONFIG_FSL_QMAN_POLL_LIMIT=32
CONFIG_FSL_QMAN_CONFIG=y
CONFIG_FSL_QMAN_DEBUGFS=y
CONFIG_FSL_QMAN_FQD_SZ=10
CONFIG_FSL_QMAN_PFDR_SZ=13
CONFIG_FSL_QMAN_CI_SCHED_CFG_SRCCIV=4
CONFIG_FSL_QMAN_CI_SCHED_CFG_SRQ_W=3
CONFIG_FSL_QMAN_CI_SCHED_CFG_RW_W=2
CONFIG_FSL_QMAN_CI_SCHED_CFG_BMAN_W=2
CONFIG_FSL_QMAN_PIRQ_DQRR_ITHRESH=12
CONFIG_FSL_QMAN_PIRQ_MR_ITHRESH=4
CONFIG_FSL_QMAN_PIRQ_IPERIOD=100
CONFIG_FSL_QMAN_FQ_LOOKUP=y
CONFIG_FSL_QMAN_INIT_TIMEOUT=10

# --- ASK kernel hooks (patches/kernel) ----------------------------------------
CONFIG_CPE_FAST_PATH=y
CONFIG_INET_IPSEC_OFFLOAD=y
CONFIG_INET6_IPSEC_OFFLOAD=y
CONFIG_THERMAL_GOV_LINEAR=y
CONFIG_THERMAL_DEFAULT_GOV_LINEAR=y
# Built in, as in OpenWrt: the ASK hooks in the built-in SDK driver and core
# net reach into these.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_BRIDGE=y
CONFIG_XFRM_ALGO=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ESP=y
# IPsec counters in /proc/net/xfrm_stat, as ASK's kernel (ask.cfg) has them.
CONFIG_XFRM_STATISTICS=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
# Per-flowtable statistics in /proc/net/stat/nf_flowtable, as in ask.cfg.
CONFIG_NF_FLOW_TABLE_PROCFS=y
CONFIG_NFT_FLOW_OFFLOAD=m

# --- SEC (CAAM): IPsec offload ------------------------------------------------
CONFIG_CRYPTO_DEV_FSL_CAAM_COMMON=y
CONFIG_CRYPTO_DEV_FSL_CAAM=y
CONFIG_CRYPTO_DEV_FSL_CAAM_JR=y
CONFIG_CRYPTO_DEV_FSL_CAAM_CRYPTO_API_DESC=y
CONFIG_CRYPTO_DEV_FSL_CAAM_AHASH_API_DESC=y
CONFIG_CRYPTO_DEV_FSL_CAAM_RINGSIZE=9
CONFIG_CRYPTO_DEV_FSL_CAAM_INTC=y
CONFIG_CRYPTO_DEV_FSL_CAAM_INTC_COUNT_THLD=255
CONFIG_CRYPTO_DEV_FSL_CAAM_INTC_TIME_THLD=2048
CONFIG_CRYPTO_DEV_FSL_CAAM_CRYPTO_API=y
CONFIG_CRYPTO_DEV_FSL_CAAM_AHASH_API=y
CONFIG_CRYPTO_DEV_FSL_CAAM_PKC_API=y
CONFIG_CRYPTO_DEV_FSL_CAAM_RNG_API=y
CONFIG_CRYPTO_DEV_FSL_CAAM_PRNG_API=y

# --- SoC / board ---------------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
# eMMC holds the root filesystem: the whole MMC stack is built in.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ESDHC=y
CONFIG_FSL_GUTS=y
CONFIG_FSL_RCPM=y
CONFIG_FSL_EDMA=y
CONFIG_NVMEM_LAYERSCAPE_SFP=y
CONFIG_QORIQ_CPUFREQ=y
CONFIG_QORIQ_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_IMX2_WDT=y
CONFIG_POWER_RESET_GPIO=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_PCI_LAYERSCAPE=y
CONFIG_I2C_IMX=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y
CONFIG_I2C_CHARDEV=y
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_PCA953X_IRQ=y
CONFIG_RTC_DRV_PCF2127=y
CONFIG_SENSORS_EMC2305=y
CONFIG_SENSORS_INA2XX=m
CONFIG_SENSORS_INA238=y
CONFIG_SENSORS_LM90=m
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_NETDEV=y
# LED blinks on tty traffic (trigger "tty", ttyname e.g. ttyS0).
CONFIG_LEDS_TRIGGER_TTY=y
CONFIG_TYPEC=y
CONFIG_TYPEC_HD3SS3220=m
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y
# QSPI NOR: the board's stable boot chain (RCW/BL2, U-Boot, its environment,
# the FMan microcode); the eMMC carries a second chain in its first 32 MiB.
CONFIG_SPI=y
CONFIG_SPI_FSL_QUADSPI=y
CONFIG_SPI_FSL_DSPI=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_BLOCK=y

# --- PHY / MDIO / SFP ---------------------------------------------------------
# The SDK MAC needs phylink built in (patches/185-sdk_dpaa-select-phylink.patch).
CONFIG_PHYLINK=y
CONFIG_SFP=m
CONFIG_MDIO_I2C=m
# PHY drivers built in so the SDK MACs find them when they probe.
CONFIG_FSL_XGMAC_MDIO=y
CONFIG_FSL_PQ_MDIO=y
CONFIG_MAXLINEAR_GPHY=y
CONFIG_AQUANTIA_PHY=y
CONFIG_REALTEK_PHY=y
CONFIG_MARVELL_10G_PHY=y
CONFIG_BROADCOM_PHY=y
CONFIG_BCM87XX_PHY=y
CONFIG_MICREL_PHY=y
CONFIG_VITESSE_PHY=y
CONFIG_CORTINA_PHY=y
CONFIG_DP83867_PHY=y
