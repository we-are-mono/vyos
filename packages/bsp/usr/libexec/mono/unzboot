#!/usr/bin/python3
# unzboot <vmlinuz> <Image>: the raw arm64 Image inside VyOS's kernel.
#
# U-Boot's booti needs the raw Image ("ARMd" at 0x38). VyOS builds an EFI
# zboot vmlinuz (CONFIG_EFI_ZBOOT): a PE stub around a compressed Image,
# described by its "zimg" header (payload offset and size at 8, compression
# name at 0x18). A gzip Image or a raw Image passes through.
import gzip
import os
import struct
import sys

src, dst = sys.argv[1], sys.argv[2]
with open(src, 'rb') as f:
    data = f.read()
if data[4:8] == b'zimg':
    off, size = struct.unpack_from('<II', data, 8)
    comp = data[0x18:0x20].rstrip(b'\0')
    if comp != b'gzip':
        sys.exit(f'unzboot: zboot payload is {comp!r}, only gzip is handled')
    img = gzip.decompress(data[off:off + size])
elif data[:2] == b'\x1f\x8b':
    img = gzip.decompress(data)
else:
    img = data
if img[0x38:0x3c] != b'ARMd':
    sys.exit(f'unzboot: no arm64 Image in {src}')
tmp = dst + '.tmp'
with open(tmp, 'wb') as f:
    f.write(img)
    f.flush()
    os.fsync(f.fileno())
os.replace(tmp, dst)
